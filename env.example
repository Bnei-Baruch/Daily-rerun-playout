# =============================================================================
# SVIVA PLAYT SYSTEM - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and customize the values for your environment
# cp env.example .env

# =============================================================================
# PRODUCTION DEPLOYMENT SETTINGS
# =============================================================================
# Production server connection details
PROD_HOST=user@your-server-ip
PROD_DIR=/path/to/your/production/directory

# =============================================================================
# SYSTEM PATHS AND DIRECTORIES
# =============================================================================
# Base directories for the system
STATE_DIR=/opt/backup/state
LOG_DIR=/opt/backup/logs
BB_STATUS_FILE=/opt/backup/status.json
BIN_DST=/usr/local/bin
LATEST_DIR=/opt/backup/latest
PLAYLIST_DIR=/opt/backup/playlist

# =============================================================================
# PLAYT SYSTEM CONFIGURATION
# =============================================================================
# Default overlay image path
OVERLAY_PNG=/path/to/your/overlay.png

# GStreamer binary path (auto-detected if not set)
GST_PATH=/usr/local/bin/gst-launch-1.0

# FFmpeg binary path (auto-detected if not set)
FFMPEG_PATH=/usr/local/bin/ffmpeg

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Optional Bearer token for HTTP API authentication
# Leave empty to disable authentication (accepts local calls without token)
STATUS_HTTP_TOKEN=your-secret-token-here

# =============================================================================
# AUDIO/VIDEO SETTINGS
# =============================================================================
# JACK audio settings
JACK_RATE=48000
JACK_BUFFER=256
JACK_NPERIODS=3

# Video output settings
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FRAMERATE=25
VIDEO_FORMAT=UYVY
VIDEO_INTERLACE=true

# =============================================================================
# NETWORK SETTINGS
# =============================================================================
# HTTP server settings
HTTP_HOST=127.0.0.1
HTTP_PORT=8787

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Development environment flag
DEV_MODE=false

# Debug logging level
LOG_LEVEL=info
